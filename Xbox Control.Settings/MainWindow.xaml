<Window x:Class="XboxControl.Settings.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:XboxControl.Settings"
        Title="Xbox Control for SolidWorks"
        Width="1320" Height="860" MinWidth="1180" MinHeight="600"
        WindowStartupLocation="CenterScreen" Icon="Assets/app.ico">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,12,16,12" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="Secondary" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <!-- Grouped dropdown headers ("Zoom", "Views", "Hold to move"...). -->
        <GroupStyle x:Key="ChoiceGroups">
            <GroupStyle.HeaderTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Margin="12,8,0,2"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </DataTemplate>
            </GroupStyle.HeaderTemplate>
        </GroupStyle>

        <!-- Highlight shown while the control is being used. -->
        <Style x:Key="ActiveGlow" TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="Opacity" Value="0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Opacity" Value="0.18" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ActiveBar" TargetType="Border">
            <Setter Property="Width" Value="3" />
            <Setter Property="CornerRadius" Value="1.5" />
            <Setter Property="Margin" Value="0,6,0,6" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="Visibility" Value="Hidden" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate DataType="{x:Type local:AxisRow}">
            <Grid Margin="-8,2,-8,2">
                <Border Style="{StaticResource ActiveGlow}" />
                <Border Style="{StaticResource ActiveBar}" />
                <Grid Margin="12,4,8,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Options}" DisplayMemberPath="Label"
                              SelectedValuePath="Value" SelectedValue="{Binding Selected}"
                              HorizontalAlignment="Stretch" />
                    <CheckBox Grid.Column="2" Content="Invert" IsChecked="{Binding Invert}"
                              Margin="12,0,0,0" MinWidth="0" VerticalAlignment="Center"
                              ToolTip="Reverse the direction" />
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:ButtonRow}">
            <Grid Margin="-8,2,-8,2">
                <Border Style="{StaticResource ActiveGlow}" />
                <Border Style="{StaticResource ActiveBar}" />
                <Grid Margin="12,4,8,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Options}" DisplayMemberPath="Label"
                              SelectedValuePath="Value" SelectedValue="{Binding Selected}"
                              HorizontalAlignment="Stretch" MaxDropDownHeight="420">
                        <ComboBox.GroupStyle>
                            <StaticResource ResourceKey="ChoiceGroups" />
                        </ComboBox.GroupStyle>
                    </ComboBox>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:RowGroup}">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}" />
                    <ItemsControl ItemsSource="{Binding Rows}" Focusable="False" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:SpeedSetting}">
            <StackPanel Margin="0,2,24,4">
                <Grid>
                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Display}" HorizontalAlignment="Right" Style="{StaticResource Secondary}" />
                </Grid>
                <Slider Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Value="{Binding Value}" Margin="0,4,0,0" />
                <TextBlock Text="{Binding Hint}" FontSize="12" Style="{StaticResource Secondary}" TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>

        <!-- Controller drawing colors (switched to the accent color while a control is used). -->
        <Style x:Key="Part" TargetType="Shape">
            <Setter Property="Fill" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="Stroke" Value="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
            <Setter Property="StrokeThickness" Value="1.5" />
        </Style>
        <Style x:Key="PartLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
    </Window.Resources>

    <Grid Margin="28,20,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="0,0,0,16">
            <StackPanel>
                <TextBlock FontSize="28" FontWeight="SemiBold"><Run Text="Xbox Control" /><Run Text="  for SolidWorks" FontSize="17" FontWeight="Normal" Foreground="{DynamicResource TextFillColorSecondaryBrush}" /></TextBlock>
                <TextBlock Text="Choose what each button and stick does in SolidWorks. Press a button or move a stick to find it below."
                           Style="{StaticResource Secondary}" Margin="0,2,0,0" />
            </StackPanel>
            <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="14" Padding="12,6"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center" Fill="Gray" />
                    <TextBlock x:Name="StatusText" Text="Looking for a controller..." VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="410" />
                        <ColumnDefinition Width="*" MinWidth="340" />
                        <ColumnDefinition Width="410" />
                    </Grid.ColumnDefinitions>

                    <ItemsControl x:Name="LeftCards" Focusable="False" />

                    <StackPanel Grid.Column="1" Margin="20,0,20,0">
                        <ContentControl x:Name="TriggerCard" Focusable="False" />

                        <Viewbox Stretch="Uniform" Margin="0,10,0,2" MaxHeight="190">
                            <Canvas Width="420" Height="290">
                                <!-- triggers and bumpers sit behind the body -->
                                <Rectangle x:Name="PartLT" Style="{StaticResource Part}" Canvas.Left="92" Canvas.Top="4" Width="60" Height="44" RadiusX="16" RadiusY="16" />
                                <Rectangle x:Name="PartRT" Style="{StaticResource Part}" Canvas.Left="268" Canvas.Top="4" Width="60" Height="44" RadiusX="16" RadiusY="16" />
                                <TextBlock Canvas.Left="114" Canvas.Top="12" Text="LT" Style="{StaticResource PartLabel}" />
                                <TextBlock Canvas.Left="290" Canvas.Top="12" Text="RT" Style="{StaticResource PartLabel}" />
                                <Rectangle x:Name="PartLB" Style="{StaticResource Part}" Canvas.Left="66" Canvas.Top="36" Width="112" Height="40" RadiusX="14" RadiusY="14" />
                                <Rectangle x:Name="PartRB" Style="{StaticResource Part}" Canvas.Left="242" Canvas.Top="36" Width="112" Height="40" RadiusX="14" RadiusY="14" />
                                <TextBlock Canvas.Left="114" Canvas.Top="42" Text="LB" Style="{StaticResource PartLabel}" />
                                <TextBlock Canvas.Left="290" Canvas.Top="42" Text="RB" Style="{StaticResource PartLabel}" />

                                <Path Fill="{DynamicResource SolidBackgroundFillColorTertiaryBrush}"
                                      Stroke="{DynamicResource ControlStrongStrokeColorDefaultBrush}" StrokeThickness="1.5"
                                      Data="M 130,62 L 290,62 C 340,62 372,84 386,128 L 410,222 C 420,262 392,288 360,272 C 338,261 322,238 304,216 L 116,216 C 98,238 82,261 60,272 C 28,288 0,262 10,222 L 34,128 C 48,84 80,62 130,62 Z" />

                                <!-- left stick -->
                                <Ellipse x:Name="PartLS" Style="{StaticResource Part}" Canvas.Left="92" Canvas.Top="94" Width="56" Height="56" />
                                <Ellipse x:Name="ThumbLS" Style="{StaticResource Part}" Canvas.Left="103" Canvas.Top="105" Width="34" Height="34">
                                    <Ellipse.RenderTransform><TranslateTransform x:Name="MoveLS" /></Ellipse.RenderTransform>
                                </Ellipse>

                                <!-- d-pad -->
                                <Rectangle Style="{StaticResource Part}" Canvas.Left="158" Canvas.Top="168" Width="16" Height="16" />
                                <Rectangle x:Name="PartDUp" Style="{StaticResource Part}" Canvas.Left="158" Canvas.Top="148" Width="16" Height="21" RadiusX="3" RadiusY="3" />
                                <Rectangle x:Name="PartDDown" Style="{StaticResource Part}" Canvas.Left="158" Canvas.Top="183" Width="16" Height="21" RadiusX="3" RadiusY="3" />
                                <Rectangle x:Name="PartDLeft" Style="{StaticResource Part}" Canvas.Left="138" Canvas.Top="168" Width="21" Height="16" RadiusX="3" RadiusY="3" />
                                <Rectangle x:Name="PartDRight" Style="{StaticResource Part}" Canvas.Left="173" Canvas.Top="168" Width="21" Height="16" RadiusX="3" RadiusY="3" />

                                <!-- right stick -->
                                <Ellipse x:Name="PartRS" Style="{StaticResource Part}" Canvas.Left="226" Canvas.Top="149" Width="56" Height="56" />
                                <Ellipse x:Name="ThumbRS" Style="{StaticResource Part}" Canvas.Left="237" Canvas.Top="160" Width="34" Height="34">
                                    <Ellipse.RenderTransform><TranslateTransform x:Name="MoveRS" /></Ellipse.RenderTransform>
                                </Ellipse>

                                <!-- view / menu and the center button (not mappable) -->
                                <Ellipse Style="{StaticResource Part}" Canvas.Left="196" Canvas.Top="80" Width="28" Height="28" Opacity="0.6" />
                                <Rectangle x:Name="PartView" Style="{StaticResource Part}" Canvas.Left="172" Canvas.Top="118" Width="20" Height="13" RadiusX="6" RadiusY="6" />
                                <Rectangle x:Name="PartMenu" Style="{StaticResource Part}" Canvas.Left="228" Canvas.Top="118" Width="20" Height="13" RadiusX="6" RadiusY="6" />

                                <!-- face buttons -->
                                <Ellipse x:Name="PartY" Style="{StaticResource Part}" Canvas.Left="293" Canvas.Top="82" Width="26" Height="26" />
                                <Ellipse x:Name="PartX" Style="{StaticResource Part}" Canvas.Left="268" Canvas.Top="107" Width="26" Height="26" />
                                <Ellipse x:Name="PartB" Style="{StaticResource Part}" Canvas.Left="318" Canvas.Top="107" Width="26" Height="26" />
                                <Ellipse x:Name="PartA" Style="{StaticResource Part}" Canvas.Left="293" Canvas.Top="132" Width="26" Height="26" />
                                <Grid Canvas.Left="293" Canvas.Top="82" Width="26" Height="26"><TextBlock Text="Y" Style="{StaticResource PartLabel}" /></Grid>
                                <Grid Canvas.Left="268" Canvas.Top="107" Width="26" Height="26"><TextBlock Text="X" Style="{StaticResource PartLabel}" /></Grid>
                                <Grid Canvas.Left="318" Canvas.Top="107" Width="26" Height="26"><TextBlock Text="B" Style="{StaticResource PartLabel}" /></Grid>
                                <Grid Canvas.Left="293" Canvas.Top="132" Width="26" Height="26"><TextBlock Text="A" Style="{StaticResource PartLabel}" /></Grid>
                            </Canvas>
                        </Viewbox>

                        <TextBlock HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontSize="12"
                                   Style="{StaticResource Secondary}" Margin="0,0,0,12"
                                   Text="Orbit turns the model. Move actions move your point of view, like walking through it." />

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Speed and feel" Style="{StaticResource CardTitle}" />
                                <ItemsControl x:Name="SpeedItems" Focusable="False" Margin="0,4,-24,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <ItemsControl x:Name="RightCards" Grid.Column="2" Focusable="False" />
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="SaveGlyph" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE73E;"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock x:Name="SaveText" Text="Changes are saved automatically and apply in SolidWorks right away."
                               Style="{StaticResource Secondary}" VerticalAlignment="Center" />
                </StackPanel>
                <!-- Credit line -->
                <TextBlock FontSize="12" Style="{StaticResource Secondary}" Margin="0,4,0,0"><Run Text="Made by Kevin Ouellette" /><Run Text="  ·  " /><Run x:Name="VersionText" Text="Version" /><Run Text="  ·  " /><Hyperlink NavigateUri="https://github.com/kevinoue/Xbox-Control" RequestNavigate="Link_RequestNavigate">GitHub</Hyperlink></TextBlock>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Open settings file" Click="OpenFile_Click" Margin="0,0,8,0" />
                <Button Content="Reset to defaults" Click="Reset_Click" Margin="0,0,8,0" />
                <Button Content="Done" Click="Done_Click" MinWidth="96" Style="{DynamicResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
