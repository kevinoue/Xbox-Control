<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Xbox_Control.Tests</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Xbox Control\Xbox Control.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The add-in is .NET Framework 4.8, so its SolidWorks-free logic is compiled in here directly. -->
    <Compile Include="..\Xbox Control.Addin\OrbitNavigator.cs" Link="Addin\OrbitNavigator.cs" />
    <Compile Include="..\Xbox Control.Addin\NavigationSettings.cs" Link="Addin\NavigationSettings.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
