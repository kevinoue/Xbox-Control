<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Measures how fast SolidWorks responds to direct view/camera API calls from a separate
    program. Decides whether the direct-control version can stay a standalone app or needs
    to run inside SolidWorks as an add-in.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <SolidWorksApiDir Condition="'$(SolidWorksApiDir)' == ''">C:\Program Files\SOLIDWORKS Corp\SOLIDWORKS\api\redist</SolidWorksApiDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embedded interop types: no SolidWorks DLLs ship with the app, and one build works
         with whichever SolidWorks version is running (2023 and later). -->
    <Reference Include="SolidWorks.Interop.sldworks">
      <HintPath>$(SolidWorksApiDir)\SolidWorks.Interop.sldworks.dll</HintPath>
      <EmbedInteropTypes>true</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
